# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Bare076New' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'Bare076NewTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Drop the auto-export of nested modules in the SDK pod's modulemap so
    # Swift's dependency scanning doesn't pull in C++ STL headers
    # (`<utility>`, `<optional>`, `<cassert>`) via RCTRequired etc.
    %w[react-native-sinch-push react-native-keychain].each do |pod_name|
      support_dir = File.join(installer.sandbox.root, 'Target Support Files', pod_name)
      next unless File.directory?(support_dir)

      modulemap_path = File.join(support_dir, "#{pod_name}.modulemap")
      if File.exist?(modulemap_path)
        contents = File.read(modulemap_path)
        if contents.include?('module * { export * }')
          new_contents = contents.lines.reject { |l| l.strip == 'module * { export * }' }.join
          File.open(modulemap_path, 'w') { |f| f.write(new_contents) }
        end
      end
    end

    # Force FMT_USE_CONSTEVAL=0 across all pod targets — Xcode 26's clang
    # rejects fmt's consteval format-string constructors ("call to consteval
    # function ... is not a constant expression") which RN 0.76's bundled
    # fmt emits. Also patch fmt's base.h to honour the macro even when
    # __cpp_lib_is_constant_evaluated is defined by the toolchain.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        c.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        defs = Array(c.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
        defs << 'FMT_USE_CONSTEVAL=0' unless defs.include?('FMT_USE_CONSTEVAL=0')
        c.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end
    end

    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      unless contents.include?('// FMT_CONSTEVAL_PATCHED')
        # Replace the auto-detect cascade with a hard-coded 0. The original
        # block sets FMT_USE_CONSTEVAL=1 when __cpp_consteval is defined,
        # which trips Xcode 26's stricter clang consteval evaluation.
        detect_block = <<~'PATCHED'
          // Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.
          // FMT_CONSTEVAL_PATCHED: hard-disable for Xcode 26 compatibility.
          #define FMT_USE_CONSTEVAL 0
          #if 0 // original detect block disabled
          #if !defined(__cpp_lib_is_constant_evaluated)
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_CPLUSPLUS < 201709L
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_GLIBCXX_RELEASE && FMT_GLIBCXX_RELEASE < 10
          #  define FMT_USE_CONSTEVAL 0
          #elif FMT_LIBCPP_VERSION && FMT_LIBCPP_VERSION < 10000
          #  define FMT_USE_CONSTEVAL 0
          #elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
          #elif FMT_MSC_VERSION && FMT_MSC_VERSION < 1929
          #  define FMT_USE_CONSTEVAL 0  // consteval is broken in MSVC VS2019 < 16.10.
          #elif defined(__cpp_consteval)
          #  define FMT_USE_CONSTEVAL 1
          #elif FMT_GCC_VERSION >= 1002 || FMT_CLANG_VERSION >= 1101
          #  define FMT_USE_CONSTEVAL 1
          #else
          #  define FMT_USE_CONSTEVAL 0
          #endif
          #endif // FMT_CONSTEVAL_PATCHED
        PATCHED
        # Find the original detect block in the file (from the comment to its closing #endif).
        start_idx = contents.index('// Detect consteval, C++20 constexpr extensions and std::is_constant_evaluated.')
        end_idx = start_idx && contents.index('#if FMT_USE_CONSTEVAL', start_idx)
        if start_idx && end_idx
          patched = contents[0...start_idx] + detect_block + contents[end_idx..]
          File.open(fmt_base, 'w') { |f| f.write(patched) }
        end
      end
    end
  end
end

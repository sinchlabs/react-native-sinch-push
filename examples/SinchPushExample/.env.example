# Used only by `npm run send-test-push` (scripts/send-test-push.mjs).
# Copy to .env (git-ignored) and fill in. These are Conversation API credentials,
# NOT the Sinch Push client secret: never put them in the app.

# Conversation API region: us | eu | br
SINCH_REGION=eu
# Sinch Build dashboard -> Conversation API: project id and the app (app_id).
# The app must have the Sinch Push channel enabled (contact Sinch / check the
# dashboard), otherwise sending fails with 400/403.
SINCH_PROJECT_ID=
SINCH_APP_ID=
# Access key (Build dashboard -> Access keys): the script exchanges key id + secret
# for an OAuth2 token (POST https://auth.sinch.com/oauth2/token, client credentials)
# and sends it as Bearer ...
SINCH_KEY_ID=
SINCH_KEY_SECRET=
# ... or, instead, a ready-made OAuth2 access token (used as Bearer when set; skips the exchange).
SINCH_ACCESS_TOKEN=

{
  "name": "@sinch/react-native-sinch-push",
  "version": "1.0.0",
  "description": "React Native SDK for Sinch Push — identity registration and push receive handling, with native APNs (iOS) and Firebase Cloud Messaging (Android) device token capture. Supports both the old and new (TurboModule) architectures.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!ios/generated",
    "!android/build",
    "!android/generated",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli lib",
    "prepack": "bob build",
    "proto:gen": "buf generate",
    "proto:gen:protoc": "sh ./protoc.sh",
    "proto:clean": "sh ./protoc.sh --clean"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "sinch",
    "push",
    "notifications",
    "fcm",
    "apns",
    "turbomodule"
  ],
  "repository": "https://github.com/sinchlabs/react-native-sinch-push.git",
  "author": "Sinch",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@react-native/eslint-config": "^0.74.0",
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.44",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-builder-bob": "^0.30.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-keychain": "^9.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "crypto-js": "^4.2.0"
  },
  "codegenConfig": {
    "name": "RNSinchPushSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.sinchpush"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  }
}

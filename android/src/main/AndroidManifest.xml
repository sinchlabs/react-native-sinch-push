<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The push socket relay's FOREGROUND_SERVICE permissions and
        SinchPushSocketService live in src/relay/AndroidManifest.xml, merged only
        when SinchPush_relay=true (see android/build.gradle). The relay is off by
        default, so a default build declares no foreground service at all.

        The FCM default notification channel <meta-data> lives in
        src/channel/AndroidManifest.xml (and src/relay-channel/, with the relay),
        merged unless SinchPush_defaultNotificationChannel=false or the FCM
        service is disabled, so a host that declares its own channel id does not
        hit a manifest-merger conflict.
    -->

    <!--
        Auto-detected Firebase Messaging integration. The service is gated by the
        SinchPush_fcmServiceEnabled manifest placeholder, which build.gradle sets
        based on SinchPush_firebaseMessaging:
          * "optional" / "required" -> placeholder = "true"  (default)
          * "none"                   -> placeholder = "false"

        Even when enabled, the service is a no-op at runtime if the host app does
        not actually include Firebase Messaging (no MESSAGING_EVENT broadcast will
        ever reach it). Hosts that declare their own FirebaseMessagingService can
        set SinchPush_firebaseMessaging = "none" to disable this one and prevent
        double-handling.
    -->
    <application>
        <service
            android:name=".SinchPushFirebaseMessagingService"
            android:exported="false"
            android:enabled="${SinchPush_fcmServiceEnabled}">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>